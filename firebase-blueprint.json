  "firestore": {
    "contact_messages": {
      "schema": "ContactMessage",
      "description": "Stores contact messages from users."
    },
    "news_events": {
      "schema": "NewsEvent",
      "description": "Stores news and events."
    },
    "promo_content": {
      "schema": "PromoContent",
      "description": "Stores the promo popup content. Document ID is 'current'."
    },
    "courses": {
      "schema": "Course",
      "description": "Stores the courses offered."
    },
    "features": {
      "schema": "Feature",
      "description": "Stores the features/services offered."
    },
    "gallery": {
      "schema": "GalleryImage",
      "description": "Stores gallery images."
